    "semanticTokenColors": {
        "parameter": {
            "foreground": "#666666",
            "italic": true
        },
        "property": {
            "foreground": "#0070f3"
        },
        "property.declaration": {
            "foreground": "#0070f3",
            "bold": true
        },
        "variable.readonly": {
            "foreground": "#b25e09"
        },
        "variable.readonly.defaultLibrary": {
            "foreground": "#b25e09"
        },
        "type": {
            "foreground": "#7928ca",
            "bold": true
        },
        "type.defaultLibrary": {
            "foreground": "#7928ca",
            "bold": true
        },
        "interface": {
            "foreground": "#7928ca",
            "italic": true
        },
        "class": {
            "foreground": "#7928ca",
            "bold": true
        },
        "class.defaultLibrary": {
            "foreground": "#7928ca",
            "bold": true
        },
        "enum": {
            "foreground": "#7928ca"
        },
        "enumMember": {
            "foreground": "#b25e09"
        },
        "namespace": {
            "foreground": "#7928ca"
        },
        "function": {
            "foreground": "#0070f3"
        },
        "function.defaultLibrary": {
            "foreground": "#0070f3",
            "italic": true
        },
        "method": {
            "foreground": "#0070f3"
        },
        "macro": {
            "foreground": "#bd2864",
            "italic": true
        },
        "decorator": {
            "foreground": "#0070f3",
            "italic": true
        },
        "selfKeyword": {
            "foreground": "#bd2864",
            "italic": true
        },
        "*.async": {
            "italic": true
        },
        "*.static": {
            "italic": true
        },
        "*.deprecated": {
            "strikethrough": true
        }
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8f8f8f",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "string constant.other.placeholder"
            ],
            "settings": {
                "foreground": "#171717"
            }
        },
        {
            "name": "Colors",
            "scope": [
                "constant.other.color"
            ],
            "settings": {
                "foreground": "#000000"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#e00000"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword"
            ],
            "settings": {
                "foreground": "#bd2864"
            }
        },
        {
            "name": "Storage Type (class/function/const)",
            "scope": [
                "storage.type"
            ],
            "settings": {
                "foreground": "#bd2864"
            }
        },
        {
            "name": "Storage Modifier (async/static/export)",
            "scope": [
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#bd2864",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Operator, Misc",
            "scope": [
                "keyword.control",
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.end.html",
                "punctuation.section.embedded",
                "keyword.other.template",
                "keyword.other.substitution"
            ],
            "settings": {
                "foreground": "#666666"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml",
                "markup.deleted.git_gutter"
            ],
            "settings": {
                "foreground": "#bd2864",
                "fontStyle": "bold"
            }
        },
        {
            "name": "JSX/HTML Attribute",
            "scope": [
                "entity.other.attribute-name",
                "meta.tag entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#b25e09",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Function, Special Method",
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "variable.function",
                "support.function",
                "keyword.other.special-method"
            ],
            "settings": {
                "foreground": "#0070f3"
            }
        },
        {
            "name": "Block Level Variables",
            "scope": [
                "meta.block variable.other"
            ],
            "settings": {
                "foreground": "#171717"
            }
        },
        {
            "name": "Other Variable, String Link",
            "scope": [
                "support.other.variable",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#171717"
            }
        },
        {
            "name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
            "scope": [
                "constant.numeric",
                "constant.language",
                "support.constant",
                "constant.character",
                "constant.escape",
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": {
                "foreground": "#b25e09"
            }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": {
                "foreground": "#067a6e"
            }
        },
        {
            "name": "Class, Type, Support",
            "scope": [
                "entity.name",
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types"
            ],
            "settings": {
                "foreground": "#7928ca",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Interface",
            "scope": [
                "entity.name.type.interface"
            ],
            "settings": {
                "foreground": "#7928ca",
                "fontStyle": "italic bold"
            }
        },
        {
            "name": "CSS Class and Support",
            "scope": [
                "source.css support.type.property-name",
                "source.sass support.type.property-name",
                "source.scss support.type.property-name",
                "source.less support.type.property-name",
                "source.stylus support.type.property-name",
                "source.postcss support.type.property-name"
            ],
            "settings": {
                "foreground": "#0070f3"
            }
        },
        {
            "name": "Sub-methods",
            "scope": [
                "entity.name.module.js",
                "variable.import.parameter.js",
                "variable.other.class.js"
            ],
            "settings": {
                "foreground": "#e00000"
            }
        },
        {
            "name": "Language methods (this/self/super)",
            "scope": [
                "variable.language"
            ],
            "settings": {
                "foreground": "#bd2864",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter.function",
                "meta.function.parameters variable"
            ],
            "settings": {
                "foreground": "#666666",
                "fontStyle": "italic"
            }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "text.html.basic entity.other.attribute-name.html",
                "text.html.basic entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#b25e09",
                "fontStyle": "italic"
            }
        },
        {
            "name": "CSS Classes",
            "scope": [
                "entity.other.attribute-name.class"
            ],
            "settings": {
                "foreground": "#b25e09"
            }
        },
        {
            "name": "CSS ID's",
            "scope": [
                "source.sass keyword.control"
            ],
            "settings": {
                "foreground": "#0070f3"
            }
        },
        {
            "name": "Inserted",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#0a7d3a"
            }
        },
        {
            "name": "Deleted",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#e00000"
            }
        },
        {
            "name": "Changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#7928ca"
            }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#067a6e"
            }
        },
        {
            "name": "Escape Characters",
            "scope": [
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#067a6e"
            }
        },
        {
            "name": "URL",
            "scope": [
                "*url*",
                "*link*",
                "*uri*"
            ],
            "settings": {
                "fontStyle": "underline"
            }
        },
        {
            "name": "Decorators",
            "scope": [
                "tag.decorator.js entity.name.tag.js",
                "tag.decorator.js punctuation.definition.tag.js",
                "meta.decorator punctuation.decorator",
                "meta.decorator entity.name.function"
            ],
            "settings": {
                "foreground": "#0070f3",
                "fontStyle": "italic"
            }
        },
        {
            "name": "ES7 Bind Operator",
            "scope": [
                "source.js constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": {
                "foreground": "#bd2864"
            }
        },
        {
            "name": "JSON Key - Level 0",
            "scope": [
                "source.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#bd2864"
            }
        },
        {
            "name": "JSON Key - Level 1",
            "scope": [
                "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#b25e09"
            }
        },
        {
            "name": "Markdown - Plain",
            "scope": [
                "text.html.markdown",
                "punctuation.definition.list_item.markdown"
            ],
            "settings": {
                "foreground": "#171717"
            }
        },
        {
            "name": "Markdown - Markup Raw Inline",
            "scope": [
                "text.html.markdown markup.inline.raw.markdown"
            ],
            "settings": {
                "foreground": "#7928ca"
            }
        },
        {
            "name": "Markdown - Heading",
            "scope": [
                "markdown.heading",
                "markup.heading | markup.heading entity.name",
                "markup.heading.markdown punctuation.definition.heading.markdown"
            ],
            "settings": {
                "foreground": "#067a6e",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup - Italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#bd2864",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup - Bold",
            "scope": [
                "markup.bold",
                "markup.bold string"
            ],
            "settings": {
                "foreground": "#b25e09",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup - Underline",
            "scope": [
                "markup.underline"
            ],
            "settings": {
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markup - Quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#666666",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup - Link",
            "scope": [
                "string.other.link",
                "markup.underline.link"
            ],
            "settings": {
                "foreground": "#0070f3",
                "fontStyle": "underline"
            }
        }
    ]
}
